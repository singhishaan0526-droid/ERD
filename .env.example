# Neon Serverless PostgreSQL Connection String (REQUIRED for database persistence)
DATABASE_URL=postgresql://user:password@ep-example.us-east-2.aws.neon.tech/neondb?sslmode=require

# Google Identity Services OAuth 2.0 Client ID (REQUIRED for Google sign-in)
# Set the same client ID for both server and frontend
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
VITE_GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com

# JWT Secret for signing session cookies (Recommended; falls back to DATABASE_URL hash if unset)
JWT_SECRET=your-secure-random-jwt-secret-at-least-32-chars

# AI ER Model Generation (Gemini or Anthropic Claude)
GEMINI_API_KEY=your_gemini_api_key_here
# ANTHROPIC_API_KEY=your_anthropic_api_key_here

PORT=3000
